// Windows resources: program icon and the version shown in Explorer > Properties > Details.
// CMake fills in the program name and version (CMakeLists.txt), once for each program.
#include <winver.h>

IDI_ICON1 ICON "@WSPRSKED_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @RC_MAJOR@,@RC_MINOR@,@RC_PATCH@,0
 PRODUCTVERSION  @RC_MAJOR@,@RC_MINOR@,@RC_PATCH@,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName",      "G4GCI"
            VALUE "FileDescription",  "@RC_NAME@"
            VALUE "FileVersion",      "@RC_VERSION@"
            VALUE "InternalName",     "@RC_EXE@"
            VALUE "LegalCopyright",   "GNU GPLv3 License"
            VALUE "OriginalFilename", "@RC_EXE@.exe"
            VALUE "ProductName",      "@RC_NAME@"
            VALUE "ProductVersion",   "@RC_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END
